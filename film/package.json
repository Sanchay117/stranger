{
  "name": "stranger-film",
  "private": true,
  "description": "The demo film: motion graphics built on the real Kane runs, the real agent transcript and the live site.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "fonts": "node scripts/fonts.ts",
    "evidence": "node scripts/evidence.ts",
    "sfx": "node scripts/sfx.ts",
    "music": "node scripts/music.ts",
    "voice": "node --env-file=../../Appwrite/.env scripts/voice.ts",
    "capture": "node scripts/capture.ts",
    "render": "nice -n 10 remotion render Stranger out/stranger-raw.mp4 --crf=18 --concurrency=4",
    "master": "node scripts/master.ts",
    "thumbnails": "nice -n 10 remotion still Thumbnail out/stranger-thumbnail-1920.png && nice -n 10 remotion still Thumbnail out/stranger-thumbnail-1280.png --scale=0.6667",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.537",
    "@remotion/cli": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "remotion": "4.0.537",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@fontsource/bricolage-grotesque": "5.2.10",
    "@fontsource/figtree": "5.2.10",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@types/react": "^19.0.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3"
  }
}
