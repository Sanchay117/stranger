# Copy to .env and fill in. .env is gitignored.

# Supabase project (Project Settings > API). The URL and anon key are public by design.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Secret. Used only by scripts/ to create demo users. Never ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Secret. Postgres connection string (Project Settings > Database > Connection string, URI, session pooler).
SUPABASE_DB_URL=

# Where Stranger points Kane: the deployed demo, or http://localhost:5231 while developing.
DUEBOOK_URL=http://localhost:5231/duebook/

# Demo accounts the seed script creates and Stranger signs in with. Demo data only.
# PUBLIC on purpose: Duebook shows them as one-click logins, so nobody has to sign up.
# Never reuse a real password here.
OWNER_EMAIL=maya@duebook.demo
OWNER_PASSWORD=
STRANGER_EMAIL=stranger@duebook.demo
STRANGER_PASSWORD=
