{
  "name": "stranger-check",
  "version": "0.1.0",
  "private": true,
  "description": "You only ever test your app as yourself. Stranger tests it as someone else, with Kane CLI.",
  "type": "module",
  "bin": {
    "stranger": "stranger/bin/stranger.js"
  },
  "files": [
    "stranger/bin",
    "stranger/src",
    "stranger/hooks",
    "stranger/skill"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "license": "MIT",
  "scripts": {
    "db:apply": "node --env-file=.env scripts/db-apply.mjs",
    "db:seed": "node --env-file=.env scripts/seed.mjs",
    "demo:reset": "node --env-file=.env scripts/demo-reset.mjs",
    "preview:setup": "node --env-file=.env scripts/preview-setup.mjs",
    "bench:apply": "node --env-file=.env scripts/bench-apply.mjs",
    "bench": "node --env-file=.env bench/run.mjs",
    "demo": "npm --prefix demo run dev",
    "stranger": "node stranger/bin/stranger.js run",
    "verify": "node stranger/bin/stranger.js verify",
    "test": "node --test stranger/test/*.test.js"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "pg": "^8.23.1"
  }
}
